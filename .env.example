# EvidenceBridge Environment Configuration

# Application
APP_NAME=EvidenceBridge
APP_ENV=development
HOST=0.0.0.0
PORT=8000
DEBUG=false

# CORS Configuration (Allowed Frontend Origins)
# Comma-separated list of origins allowed to access the API with credentials.
# In development, local dev origins (http://localhost:5173, http://127.0.0.1:5173) are included automatically.
# In production (APP_ENV=production), specify your exact deployed frontend domains (never use wildcard '*' with credentials):
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Production example:
# ALLOWED_ORIGINS=https://evidencebridge.org,https://app.evidencebridge.org

# MongoDB Configuration (Local or MongoDB Atlas)
# Either MONGODB_URL or MONGODB_URI may be used:
MONGODB_URL=mongodb://localhost:27017
# Example for MongoDB Atlas (Never commit real credentials to git):
# MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/evidencebridge
MONGODB_DB_NAME=evidencebridge
MONGODB_CLAIMS_COLLECTION=claims
MONGODB_VERIFICATIONS_COLLECTION=verifications
MONGODB_AUDIT_TRAILS_COLLECTION=audit_trails
MONGODB_TRUST_DENSITY_COLLECTION=trust_density
MONGODB_USERS_COLLECTION=users

# User Authentication & Security
AUTH_SECRET_KEY=change-in-production-random-secret-key-min-32-chars
AUTH_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM Provider Configuration ("gemini" or "ollama")
LLM_PROVIDER=gemini

# Google Gemini API Configuration (Free tier available with gemini-3.1-flash-lite)
# Obtain an API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite

# Ollama Local LLM Configuration (Alternative local-first provider)
# Recommended models: phi3:mini (fast, low RAM) or llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=phi3:mini
OLLAMA_TIMEOUT_SECONDS=60.0

# Knowledge Base & Verification
KNOWLEDGE_BASE_DIR=./data/knowledge
COST_ANOMALY_THRESHOLD_MULTIPLIER=3.0
RETRIEVAL_RELEVANCE_THRESHOLD=0.35
MIN_CONFIDENCE_THRESHOLD=0.40

# Hyperlocal Trust Density
TRUST_DENSITY_SUPPORT_WEIGHT=0.45
TRUST_DENSITY_ANOMALY_WEIGHT=0.35
TRUST_DENSITY_VOLUME_WEIGHT=0.20
TRUST_DENSITY_MIN_VOLUME=5
TRUST_DENSITY_TIME_DECAY_DAYS=45.0

# Local Vector Store (ChromaDB)
CHROMA_PERSIST_DIRECTORY=./chroma_db

# Frontend Configuration (Vite)
# When deploying the frontend separately (e.g. Netlify, Vercel, Cloudflare Pages),
# set VITE_API_BASE_URL to your deployed backend API URL (including /api/v1).
# Defaults to '/api/v1' for local development via Vite reverse proxy.
# VITE_API_BASE_URL=https://api.yourdomain.com/api/v1
# Optional: Remote Ollama URL for AI Voice Assistant (defaults to local proxy / local Ollama)
# VITE_OLLAMA_BASE_URL=https://ollama.yourdomain.com
